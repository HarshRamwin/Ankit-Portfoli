# ─────────────────────────────────────────────────────────────
# Contact form delivery (server-side only — never exposed to the browser)
# ─────────────────────────────────────────────────────────────

# 1. Create a free account at https://resend.com
# 2. Add + verify a domain (or use the shared onboarding sender for testing)
# 3. Create an API key and paste it here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where recruiter submissions are delivered.
CONTACT_EMAIL=ankitkumarmishra5155@gmail.com

# The "From" address. Must be on a domain you verified in Resend.
# For quick testing you may use: onboarding@resend.dev
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
# Public site config
# ─────────────────────────────────────────────────────────────
# Canonical URL used for metadata, OpenGraph and sitemap.
NEXT_PUBLIC_SITE_URL=https://ankitmishra.dev
